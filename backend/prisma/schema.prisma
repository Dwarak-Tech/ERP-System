datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(SALES_USER)
  createdAt DateTime @default(now())
}

model Customer {
  id            String    @id @default(uuid())
  companyName   String
  contactPerson String
  mobile        String
  email         String
  city          String
  enquiries     Enquiry[]
}

model Product {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  category         String
  unit             String
  basePrice        Decimal           @db.Decimal(10, 2)
  inventory        Inventory?
  enquiryItems     EnquiryItem[]
  quotationItems   QuotationItem[]
  salesOrderItems  SalesOrderItem[]
  dispatchItems    DispatchItem[]
}

model Inventory {
  id               String   @id @default(uuid())
  productId        String   @unique
  physicalQuantity Int      @default(0)
  reservedQuantity Int      @default(0)
  product          Product  @relation(fields: [productId], references: [id])
}

model Enquiry {
  id            String        @id @default(uuid())
  enquiryNumber String        @unique
  customerId    String
  enquiryDate   DateTime      @default(now())
  requiredDate  DateTime
  notes         String?
  status        EnquiryStatus @default(NEW)
  customer      Customer      @relation(fields: [customerId], references: [id])
  items         EnquiryItem[]
  quotations    Quotation[]
}

model EnquiryItem {
  id        String  @id @default(uuid())
  enquiryId String
  productId String
  quantity  Int
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique
  enquiryId       String
  customerId      String
  grandTotal      Decimal         @db.Decimal(12, 2)
  validUntil      DateTime
  status          QuotationStatus @default(DRAFT)
  enquiry         Enquiry         @relation(fields: [enquiryId], references: [id])
  items           QuotationItem[]
  salesOrder      SalesOrder?
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  productId   String
  quantity    Int
  unitPrice   Decimal   @db.Decimal(10, 2)
  discountPct Decimal   @default(0) @db.Decimal(5, 2)
  gstPct      Decimal   @default(0) @db.Decimal(5, 2)
  lineAmount  Decimal   @db.Decimal(12, 2)
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
}

model SalesOrder {
  id          String           @id @default(uuid())
  orderNumber String           @unique
  quotationId String           @unique
  customerId  String
  orderDate   DateTime         @default(now())
  totalAmount Decimal          @db.Decimal(12, 2)
  status      OrderStatus      @default(PENDING)
  quotation   Quotation        @relation(fields: [quotationId], references: [id])
  items       SalesOrderItem[]
  dispatches  Dispatch[]
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String
  productId    String
  quantity     Int
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])
}

model Dispatch {
  id             String         @id @default(uuid())
  dispatchNumber String         @unique
  salesOrderId   String
  dispatchDate   DateTime       @default(now())
  vehicleNumber  String
  driverName     String
  salesOrder     SalesOrder     @relation(fields: [salesOrderId], references: [id])
  items          DispatchItem[]
}

model DispatchItem {
  id         String   @id @default(uuid())
  dispatchId String
  productId  String
  quantity   Int
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
}